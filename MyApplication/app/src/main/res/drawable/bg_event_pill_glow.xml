<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2219BFAE" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <!-- Inner button surface -->
    <item
        android:left="3dp"
        android:right="3dp"
        android:top="3dp"
        android:bottom="3dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/menu_surface_alt" />
            <stroke
                android:width="2dp"
                android:color="@color/event_accent" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>
