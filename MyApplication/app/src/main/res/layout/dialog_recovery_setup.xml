<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:padding="20dp">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Recovery Questions"
        android:textColor="@color/menu_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Add at least 1 question. You'll need them to reset your password."
        android:textColor="@color/menu_text_secondary"
        android:textSize="12sp" />

    <!-- Required correct count -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Required correct answers:"
            android:textColor="@color/menu_text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/requiredMinus"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:background="@drawable/bg_event_close_button"
                android:text="–"
                android:textColor="@color/menu_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/requiredCount"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/vault_accent"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/requiredPlus"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:background="@drawable/bg_event_close_button"
                android:text="+"
                android:textColor="@color/menu_text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:alpha="0.12"
        android:background="@color/menu_text_secondary" />

    <!-- Question input area -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="NEW QUESTION"
        android:textColor="@color/menu_text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <EditText
        android:id="@+id/recoveryQQuestion"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_event_input"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="13sp"
        android:textColor="@color/menu_text_primary"
        android:textColorHint="@color/menu_text_secondary"
        android:hint="e.g. What was your first pet?"
        android:inputType="text"
        android:maxLines="2" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="ANSWER"
        android:textColor="@color/menu_text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08" />

    <EditText
        android:id="@+id/recoveryQAnswer"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_event_input"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textSize="13sp"
        android:textColor="@color/menu_text_primary"
        android:textColorHint="@color/menu_text_secondary"
        android:hint="Answer"
        android:inputType="text"
        android:maxLines="1" />

    <!-- Case-sensitive toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Case-sensitive"
            android:textColor="@color/menu_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/recoveryQCaseToggle"
            android:layout_width="44dp"
            android:layout_height="22dp"
            android:background="@drawable/bg_toggle_off"
            android:gravity="center"
            android:text="OFF"
            android:textColor="@color/menu_text_secondary"
            android:textSize="8sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Add question button -->
    <TextView
        android:id="@+id/recoveryQAddBtn"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:background="@drawable/bg_event_input"
        android:text="+ Add this question"
        android:textColor="@color/vault_accent"
        android:textSize="13sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true" />

    <!-- Questions list -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="ADDED QUESTIONS"
        android:textColor="@color/menu_text_secondary"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:visibility="gone"
        android:id="@+id/recoveryQListLabel" />

    <LinearLayout
        android:id="@+id/recoveryQList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="4dp" />

    <!-- Save button -->
    <TextView
        android:id="@+id/recoveryQSaveBtn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:background="@drawable/bg_vault_pill_purple"
        android:text="Save &amp; Continue"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
