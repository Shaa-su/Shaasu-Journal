<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/menu_bg">

    <!-- Top header bar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/headerBar"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Back button -->
        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_cal_circle_button"
            android:contentDescription="Back"
            android:scaleType="center"
            android:src="@drawable/ic_chevron_left_simple"
            android:tint="@color/menu_text_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Lock icon -->
        <ImageView
            android:id="@+id/vaultIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="10dp"
            android:src="@android:drawable/ic_menu_info_details"
            android:tint="@color/vault_accent"
            app:layout_constraintStart_toEndOf="@+id/backButton"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Vault title -->
        <TextView
            android:id="@+id/vaultTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Vault"
            android:textColor="@color/menu_text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@+id/vaultIcon"
            app:layout_constraintEnd_toStartOf="@+id/vaultBadge"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Badge count -->
        <TextView
            android:id="@+id/vaultBadge"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:gravity="center"
            android:background="@drawable/bg_vault_badge"
            android:text="0"
            android:textColor="@color/menu_text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginEnd="10dp"
            app:layout_constraintEnd_toStartOf="@+id/addButton"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- + Add button -->
        <TextView
            android:id="@+id/addButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:background="@drawable/bg_vault_pill_purple"
            android:text="+ Add"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Search bar -->
    <EditText
        android:id="@+id/searchInput"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_login_input"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="10dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:hint="Search accounts..."
        android:inputType="text"
        android:maxLines="1"
        android:textColor="@color/menu_text_primary"
        android:textColorHint="@color/menu_text_secondary"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@+id/headerBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Main content -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/searchInput"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Entries list -->
        <ScrollView
            android:id="@+id/vaultEntriesScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/vaultEntriesContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp" />

        </ScrollView>

        <!-- Empty state -->
        <ScrollView
            android:id="@+id/vaultEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="24dp">

            <!-- Empty state illustration -->
            <LinearLayout
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:gravity="center"
                android:background="@drawable/bg_vault_empty_tile"
                android:layout_marginTop="30dp">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@android:drawable/ic_menu_info_details"
                    android:tint="@color/vault_accent" />
            </LinearLayout>

            <!-- Empty state title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Vault is empty"
                android:textColor="@color/menu_text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <!-- Empty state subtitle -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Save passwords, accounts, cards &amp; notes securely"
                android:textColor="@color/menu_text_secondary"
                android:textSize="13sp"
                android:gravity="center" />

            <!-- 3x2 Category grid -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:columnCount="3"
                android:rowCount="2"
                android:useDefaultMargins="false">

                <!-- Gmail -->
                <LinearLayout
                    android:id="@+id/cardGmail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="5dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="@drawable/bg_vault_card"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@android:drawable/ic_dialog_email"
                        android:tint="#FFFF4444" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Gmail"
                        android:textColor="@color/menu_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Instagram -->
                <LinearLayout
                    android:id="@+id/cardInstagram"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="5dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="@drawable/bg_vault_card"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@android:drawable/ic_menu_camera"
                        android:tint="#FFFFD700" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Instagram"
                        android:textColor="@color/menu_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Banking -->
                <LinearLayout
                    android:id="@+id/cardBanking"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="5dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="@drawable/bg_vault_card"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@android:drawable/ic_menu_compass"
                        android:tint="#FF4488FF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Game Accounts"
                        android:textColor="@color/menu_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Credit / Debit Card -->
                <LinearLayout
                    android:id="@+id/cardCreditCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="5dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="@drawable/bg_vault_card"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
android:src="@android:drawable/ic_menu_my_calendar"
                        android:tint="#FF4488FF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Credit / Debit Card"
                        android:textColor="@color/menu_text_secondary"
                        android:textSize="11sp"
                        android:gravity="center" />
                </LinearLayout>

                <!-- Wi-Fi -->
                <LinearLayout
                    android:id="@+id/cardWifi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="5dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="@drawable/bg_vault_card"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
android:src="@android:drawable/ic_menu_myplaces"
                        android:tint="#FF22C55E" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Other Accounts"
                        android:textColor="@color/menu_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Secret Note -->
                <LinearLayout
                    android:id="@+id/cardSecretNote"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:layout_margin="5dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="14dp"
                    android:background="@drawable/bg_vault_card"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@android:drawable/ic_menu_edit"
                        android:tint="@color/vault_accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Secret Note"
                        android:textColor="@color/menu_text_secondary"
                        android:textSize="11sp" />
                </LinearLayout>

            </GridLayout>

        </LinearLayout>

    </ScrollView>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
