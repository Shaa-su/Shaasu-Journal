<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_menu_card_dark"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="16dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/reminderDialogTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Set Reminder Time"
                android:textColor="@color/menu_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/reminderToggleClock"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_reminder_time_chip_selected"
                android:gravity="center"
                android:text="⏰"
                android:textColor="@color/menu_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/reminderToggleKeyboard"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_reminder_time_chip"
                android:gravity="center"
                android:text="⌨"
                android:textColor="@color/menu_text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/reminderTimeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Time"
            android:textColor="@color/menu_text_secondary"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/reminderTitleInput"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_login_input"
            android:hint="What’s this for?"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/menu_text_primary"
            android:textColorHint="@color/menu_text_secondary"
            android:textSize="14sp"
            android:inputType="text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Time"
            android:textColor="@color/menu_text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/reminderTimeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/reminderHourChip"
                android:layout_width="56dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_reminder_time_chip"
                android:gravity="center"
                android:text="01"
                android:textColor="@color/menu_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:text=":"
                android:textColor="@color/menu_text_secondary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/reminderMinuteChip"
                android:layout_width="56dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_reminder_time_chip"
                android:gravity="center"
                android:text="00"
                android:textColor="@color/menu_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/reminderAmPmChip"
                android:layout_width="56dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_reminder_time_chip_selected"
                android:gravity="center"
                android:text="AM"
                android:textColor="@color/menu_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/reminderPickTimeHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:text="Tap time to edit"
            android:textColor="@color/menu_text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/reminderModeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="Select Hour"
            android:textColor="@color/menu_text_secondary"
            android:textSize="12sp" />

        <com.example.myapplication.ReminderClockView
            android:id="@+id/reminderClock"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:layout_marginTop="10dp" />

        <LinearLayout
            android:id="@+id/reminderKeyboardRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/reminderHourInput"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_login_input"
                android:gravity="center"
                android:hint="HH"
                android:inputType="number"
                android:textColor="@color/menu_text_primary"
                android:textColorHint="@color/menu_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:text=":"
                android:textColor="@color/menu_text_secondary"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/reminderMinuteInput"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_login_input"
                android:gravity="center"
                android:hint="MM"
                android:inputType="number"
                android:textColor="@color/menu_text_primary"
                android:textColorHint="@color/menu_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/reminderKeyboardAmPm"
                android:layout_width="60dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_reminder_time_chip_selected"
                android:gravity="center"
                android:text="AM"
                android:textColor="@color/menu_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/reminderRepeatLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Repeat"
            android:textColor="@color/menu_text_secondary"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/reminderRepeatRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/reminderRepeatOnce"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_reminder_repeat_chip"
                android:gravity="center"
                android:text="Once"
                android:textColor="@color/menu_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/reminderRepeatDaily"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_reminder_repeat_chip"
                android:gravity="center"
                android:text="Daily"
                android:textColor="@color/menu_text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/reminderCancel"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:background="@drawable/bg_reminder_action_outline"
                android:gravity="center"
                android:text="Cancel"
                android:textColor="@color/menu_text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/reminderSave"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:background="@drawable/bg_reminder_action_primary"
                android:gravity="center"
                android:text="Save"
                android:textColor="@color/menu_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
