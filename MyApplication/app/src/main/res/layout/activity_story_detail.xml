<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/menu_bg">

    <!-- Background Wallpaper Image -->
    <ImageView
        android:id="@+id/wallpaperImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop" />

    <!-- Darken wallpaper for readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_story_wallpaper_scrim" />

    <!-- Main Content -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top bar -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topBar"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@android:color/transparent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/topBarEndActionsBarrier"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="start"
                app:constraint_referenced_ids="goalTrackerPill,saveButton" />

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_story_back_circle"
                android:contentDescription="Back"
                android:src="@drawable/ic_chevron_left_simple"
                android:scaleType="center"
                android:tint="@color/menu_text_primary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <TextView
                android:id="@+id/dateDisplayText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="May 2, 2026"
                android:textColor="@color/menu_text_secondary"
                android:textSize="14sp"
                android:ellipsize="end"
                android:maxLines="1"
                android:gravity="center"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintStart_toEndOf="@+id/backButton"
                app:layout_constraintEnd_toStartOf="@+id/topBarEndActionsBarrier"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <Button
                android:id="@+id/saveButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_story_save_pill"
                android:text="Save"
                android:textColor="@color/menu_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:drawableStart="@drawable/ic_save_simple"
                android:drawablePadding="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <LinearLayout
                android:id="@+id/goalTrackerPill"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_goal_tracker_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="12dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"
                app:layout_constraintEnd_toStartOf="@+id/saveButton"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

                <FrameLayout
                    android:id="@+id/goalTrackerIconContainer"
                    android:layout_width="18dp"
                    android:layout_height="18dp">

                    <View
                        android:id="@+id/goalTrackerRing"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_goal_tracker_ring" />

                    <ImageView
                        android:id="@+id/goalTrackerCheck"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="2dp"
                        android:src="@drawable/ic_check_simple"
                        android:tint="@color/fab_goals"
                        android:visibility="gone" />

                </FrameLayout>

                <TextView
                    android:id="@+id/goalTrackerText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="0/0"
                    android:textColor="@color/menu_text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <View
            android:id="@+id/topDivider"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:alpha="0.12"
            android:background="@color/menu_text_secondary"
            app:layout_constraintTop_toBottomOf="@+id/topBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Editor content -->
        <ScrollView
            android:id="@+id/storyScroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:overScrollMode="never"
            app:layout_constraintTop_toBottomOf="@+id/topDivider"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="18dp"
                android:paddingBottom="120dp">

                <EditText
                    android:id="@+id/titleEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:hint="Title..."
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/menu_text_primary"
                    android:textColorHint="@color/menu_text_secondary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:alpha="0.18"
                    android:background="@color/menu_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="HOW ARE YOU FEELING?"
                    android:textColor="@color/menu_text_secondary"
                    android:textSize="11sp"
                    android:letterSpacing="0.08"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/moodOptionsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:weightSum="10" />

                <EditText
                    android:id="@+id/storyEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:gravity="top"
                    android:hint="Start writing your story..."
                    android:inputType="textMultiLine"
                    android:minHeight="420dp"
                    android:paddingTop="18dp"
                    android:paddingBottom="18dp"
                    android:textColor="@color/menu_text_primary"
                    android:textColorHint="@color/menu_text_secondary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />

            </LinearLayout>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Custom Floating Action Button -->
    <FrameLayout
        android:id="@+id/fabContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="8dp">

        <com.example.myapplication.FloatingActionButton
            android:id="@+id/customFab"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <!-- Goals Modal (Figma bottom sheet) -->
    <FrameLayout
        android:id="@+id/goalsModal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <View
            android:id="@+id/goalsBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#00000080" />

        <LinearLayout
            android:id="@+id/goalsSheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:background="@drawable/bg_goals_sheet"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="18dp">

            <View
                android:id="@+id/goalsHandle"
                android:layout_width="40dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/bg_goals_handle" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/goalsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Goals"
                    android:textColor="@color/menu_text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/goalsCloseButton" />

                <TextView
                    android:id="@+id/goalsCountText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="0 of 0 completed"
                    android:textColor="@color/menu_text_secondary"
                    android:textSize="12sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/goalsTitle" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/goalsProgressBar"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:layout_marginTop="10dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/goalsCountText">

                    <View
                        android:id="@+id/goalsProgressTrack"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:alpha="0.18"
                        android:background="@drawable/bg_goals_progress_track"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <View
                        android:id="@+id/goalsProgressFill"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:background="@drawable/bg_goals_progress_fill"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintWidth_percent="0" />

                </androidx.constraintlayout.widget.ConstraintLayout>

                <ImageButton
                    android:id="@+id/goalsCloseButton"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_goals_icon_button"
                    android:contentDescription="Close"
                    android:src="@drawable/ic_close_simple"
                    android:scaleType="center"
                    android:tint="@color/menu_text_secondary"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="@+id/goalsTitle" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:id="@+id/goalsKanbanScroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <!-- Column: Planning -->
                    <LinearLayout
                        android:id="@+id/colOngoingContainer"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_menu_card_dark"
                        android:orientation="vertical"
                        android:padding="6dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:text="Planning"
                            android:textColor="@color/menu_text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                        <LinearLayout
                            android:id="@+id/goalsColOngoing"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:minHeight="60dp"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <!-- Column: Ongoing -->
                    <LinearLayout
                        android:id="@+id/colWorkingContainer"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_menu_card_dark"
                        android:orientation="vertical"
                        android:padding="6dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:text="Ongoing"
                            android:textColor="@color/menu_teal"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                        <LinearLayout
                            android:id="@+id/goalsColWorking"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:minHeight="60dp"
                            android:orientation="vertical" />
                    </LinearLayout>

                    <!-- Column: Completed -->
                    <LinearLayout
                        android:id="@+id/colDoneContainer"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_menu_card_dark"
                        android:orientation="vertical"
                        android:padding="6dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="6dp"
                            android:text="Completed"
                            android:textColor="@color/menu_text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                        <LinearLayout
                            android:id="@+id/goalsColDone"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:minHeight="60dp"
                            android:orientation="vertical" />
                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/goalsEmptyText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="No goals yet. Add one below!"
                    android:textColor="@color/menu_text_secondary"
                    android:textSize="13sp" />

            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:alpha="0.12"
                android:background="@color/menu_text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/addGoalEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Add a new goal..."
                    android:imeOptions="actionDone"
                    android:inputType="textCapSentences"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:textColor="@color/menu_text_primary"
                    android:textColorHint="@color/menu_text_secondary"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/addGoalButton"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/bg_goals_icon_button"
                    android:contentDescription="Add goal"
                    android:src="@drawable/ic_add_simple"
                    android:scaleType="center"
                    android:tint="@color/menu_text_primary" />

            </LinearLayout>

            <Button
                android:id="@+id/doneGoalsButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_goals_done_button"
                android:text="Done"
                android:textAllCaps="false"
                android:textColor="@color/menu_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </FrameLayout>

</FrameLayout>



