<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="200dp"
    android:background="@drawable/bg_event_card_outline"
    android:layout_marginBottom="14dp">

    <!-- Background image -->
    <ImageView
        android:id="@+id/eventCardImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="Event background" />

    <!-- Dark scrim overlay -->
    <View
        android:id="@+id/eventScrimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000" />

    <!-- Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top row: chips + buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Left chips -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <!-- Yearly chip -->
                <TextView
                    android:id="@+id/eventYearlyChip"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:background="@drawable/bg_event_chip"
                    android:drawablePadding="4dp"
                    android:drawableStart="@android:drawable/ic_menu_agenda"
                    android:text="Yearly"
                    android:textColor="@color/menu_text_primary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Alert chip -->
                <TextView
                    android:id="@+id/eventAlertChip"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="6dp"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:background="@drawable/bg_event_chip"
                    android:drawablePadding="4dp"
                    android:drawableStart="@android:drawable/ic_lock_idle_alarm"
                    android:text="Alert on"
                    android:textColor="@color/event_accent"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Right action buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/eventAlertToggle"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_event_circle_action"
                    android:contentDescription="Toggle alert"
                    android:scaleType="center"
                    android:src="@android:drawable/ic_lock_idle_alarm"
                    android:tint="@color/event_accent" />

                <ImageButton
                    android:id="@+id/eventDeleteButton"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_event_circle_action"
                    android:contentDescription="Delete event"
                    android:scaleType="center"
                    android:src="@android:drawable/ic_menu_delete"
                    android:tint="#FFFF4444" />
            </LinearLayout>
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Title + Note -->
        <TextView
            android:id="@+id/eventCardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Birthday"
            android:textColor="@color/menu_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/eventCardNote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Happy Birthday"
            android:textColor="@color/menu_text_secondary"
            android:textSize="13sp" />

        <!-- Bottom row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/eventTodayText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🎉  Today!"
                android:textColor="@color/event_accent"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/eventDateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="June 4"
                android:textColor="@color/menu_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
